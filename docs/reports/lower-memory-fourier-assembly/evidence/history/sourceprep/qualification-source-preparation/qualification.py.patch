+def _residual(value, reference):
+    """Exact rational residual or one of the TWO fixed algebraic-reference brackets."""
+    observed = F.from_float(float(value))
+    if reference in ("1+2sqrt3","-1+2sqrt3"):
+        lower,upper = (F(13,3),F(9,2)) if reference=="1+2sqrt3" else (F(7,3),F(5,2))
+        lo,hi = observed-upper,observed-lower
+        if lo >= 0:
+            alo,ahi,left_closed = lo,hi,False
+        elif hi <= 0:
+            alo,ahi,left_closed = -hi,-lo,False
+        else:
+            alo,ahi,left_closed = F(0),max(-lo,hi),True
+        return {"observed_exact_dyadic":str(observed),"observed_hex":float(value).hex(),
+            "reference":reference,"reference_open_bracket":[str(lower),str(upper)],
+            "signed_error_interval":{"lower":str(lo),"upper":str(hi),
+                                     "lower_closed":False,"upper_closed":False},
+            "absolute_error_interval":{"lower":str(alo),"upper":str(ahi),
+                                       "lower_closed":left_closed,"upper_closed":False},
+            "meaning":"FIXED_REFERENCE_ENCLOSURE_NOT_AN_ERROR_ALLOWANCE"}
+    error = observed-reference
+    return {"observed_exact_dyadic":str(observed),"observed_hex":float(value).hex(),
+            "reference":str(reference),
+            "signed_error_interval":{"lower":str(error),"upper":str(error),
+                                     "lower_closed":True,"upper_closed":True},
+            "absolute_error_interval":{"lower":str(abs(error)),"upper":str(abs(error)),
+                                       "lower_closed":True,"upper_closed":True},
+            "meaning":"EXACT_POINTWISE_ERROR_NOT_AN_ERROR_ALLOWANCE"}
