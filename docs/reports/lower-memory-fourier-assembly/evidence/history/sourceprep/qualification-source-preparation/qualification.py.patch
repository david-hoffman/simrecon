+def _observe(label, q, bands, carriers, samples, *, omit=False, explode=1.0,
+             transfer=None):
+    """Fixed-case observations; no generic oracle/interval or acceptance engine."""
+    orders = (q.shape[2]+1)//2
+    grid = kp._Grid(bands.input_shape, orders, bands.lateral_zoom, bands.axial_zoom,
+                    bands.dxy_um, bands.dz_um, bands.input_scale,
+                    getattr(bands, "acquisition_mode", "3d"))
+    oz, oy, ox = grid.output_shape
+    x = (np.arange(ox, dtype=np.float64)-ox//2)*(bands.dxy_um/bands.lateral_zoom)
+    y = (np.arange(oy, dtype=np.float64)-oy//2)*(bands.dxy_um/bands.lateral_zoom)
+    before = identity(q, "filtered")
+    images = []
+    # LANE1 ALWAYS runs the fixed literal930e input through actual kernels.
+    # Instrumented qualification may retain comparisons; NEVER a measured child.
+    for operation in (kp.assemble_signed_image, study.candidate, study.retained_control):
+        with kp._operation():
+            images.append(operation(q, grid, carriers, omit, x, y, explode))
+    sampling = SimpleNamespace(lateral_zoom=int(bands.lateral_zoom),
+        axial_zoom=1 if q.shape[3]==1 else bands.axial_zoom,dxy_um=bands.dxy_um)
+    if q.shape[3] == 1:
+        # CE04 helper is a full3D sum. Use its A1 plane only for native2D;
+        # CE06 independently requires initialized later zeros, not replication.
+        plane, budget = assemble(q, sampling, carriers*explode, omit)
+        direct = np.zeros((q.shape[0], oz, oy, ox), np.float64)
+        direct[:, 0] = plane[:, 0]
+    else:
+        direct, budget = assemble(q, sampling, carriers*explode, omit)
+    observations = []
+    for index, reference in samples:
+        observations.append({"index": index, "reference": str(reference),
+            "variants": [_residual(image[index],reference) for image in images],
+            "independent_helper": _residual(direct[index], reference)})
+    # LANE2 independently reuses the legitimate PUBLIC result's actual inputs.
+    # It never replaces lane1 or treats different public inputs as the sparse ideal.
+    result = known(bands, transfer, carriers_cyc_um=carriers,
+                   modulation=np.zeros((q.shape[1], orders-1), np.complex128),
+                   omit_order0=omit, explode_factor=explode)
+    settings = dict(result.resolved_settings)
+    public_grid = kp._Grid(bands.input_shape,orders,settings["lateral_zoom"],settings["axial_zoom"],
+        settings["dxy_um"],settings["dz_um"],settings["input_scale"],settings.get("acquisition_mode",grid.mode))
+    kernel_input = result.filtered_quadratures
+    kernel_before = identity(kernel_input,"public.kernel.filtered")
+    public_images = []
+    for operation in (kp.assemble_signed_image,study.candidate,study.retained_control):
+        with kp._operation():
+            public_images.append(operation(kernel_input,public_grid,result.carriers_cyc_um,
+                                 omit,result.x_um,result.y_um,explode))
+    metadata_equal = all(getattr(public_grid,name)==getattr(grid,name)
+        for name in ("shape","orders","lateral","axial","dxy","dz","scale","mode"))
+    applicable = bool(np.array_equal(kernel_input,q) and metadata_equal
+        and np.array_equal(result.carriers_cyc_um,carriers)
+        and np.array_equal(result.x_um,x) and np.array_equal(result.y_um,y))
+    public_samples = [{"index":index,"variants":[_residual(image[index],reference) if applicable
+        else {"status":"NOT_APPLICABLE_PUBLIC_INPUT_OR_METADATA_DIFFERS_FROM_LITERAL"}
+        for image in public_images]} for index,reference in samples]
+    return {"case": label, "status": "OBSERVATION_ONLY_NOT_ACCEPTANCE",
+            "literal_lane":{"lifetime_complete_byte_equality":all(_same(images[0],a) for a in images[1:]),
+                "caller_unchanged":before==identity(q,"filtered"),
+                "output_identities":[identity(a,"image") for a in images],"samples":observations},
+            "public_lane":{"lifetime_complete_byte_equality":all(_same(public_images[0],a) for a in public_images[1:]),
+                "public_image_complete_bytes_equal_all_variants":all(_same(result.image,a) for a in public_images),
+                "filtered_exact_literal_bytes":_same(kernel_input,q),
+                "filtered_values_equal_literal":bool(np.array_equal(kernel_input,q)),
+                "metadata_equal_literal":metadata_equal,"literal_reference_applicable":applicable,
+                "actual_kernel_input_unchanged":kernel_before==identity(kernel_input,"public.kernel.filtered"),
+                "output_identities":[identity(a,"image") for a in public_images],"samples":public_samples},
+            "helper_existing_amplitude_budget_not_error_bound": float(budget),
+            "native_fft_error_bound":"UNQUALIFIED",
+            "sample_error_interpretation":"THRESHOLD_FREE_POINTWISE_INTERVALS_NOT_ALLOWANCES",
+            "computed_accuracy_acceptance":"NOT_PREDECLARED_FRESH_SCI_JUDGES_SUFFICIENCY",
+            "scope": "finite qualification only, not27 measured rows or workflow peak"}
